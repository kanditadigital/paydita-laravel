{
    "name": "kandita/paydita",
    "description": "Laravel client for Paydita, the internal central payment API of PT. Kandita Digital Integrasi.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Kandita\\Paydita\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kandita\\Paydita\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kandita\\Paydita\\PayditaServiceProvider"
            ],
            "aliases": {
                "Paydita": "Kandita\\Paydita\\Facades\\Paydita"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest"
    }
}
